{
  "name": "studyspace",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "db:test": "tsx --env-file=.env.local scripts/database-test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "format": "prettier --write src tests e2e scripts",
    "desktop:icons": "node desktop/scripts/icons.cjs",
    "desktop:stage": "node desktop/scripts/stage-web.cjs",
    "desktop:build": "npm run desktop:icons && npm run desktop:stage && npm --prefix desktop run pack",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "node desktop/scripts/smoke.cjs",
    "desktop:test-update": "npm --prefix desktop run test:update"
  },
  "dependencies": {
