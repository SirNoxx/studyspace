{
  "name": "studyspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "db:test": "tsx --env-file=.env.local scripts/database-test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "format": "prettier --write src tests e2e scripts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@mozilla/readability": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "diff": "latest",
    "fast-xml-parser": "latest",
    "fflate": "latest",
    "idb": "latest",
    "immer": "^11.1.18",
    "ipaddr.js": "latest",
    "jsdom": "26.1.0",
    "katex": "latest",
    "lucide-react": "latest",
    "mermaid": "latest",
    "next": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-katex": "latest",
    "rehype-sanitize": "latest",
    "remark-gfm": "latest",
    "remark-math": "latest",
    "remark-parse": "latest",
    "undici": "latest",
    "unified": "latest",
    "unist-util-visit": "latest",
    "yaml": "^2.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@types/jsdom": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.6",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  }
}
