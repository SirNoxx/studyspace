{
  "name": "studyspace",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "db:test": "tsx --env-file=.env.local scripts/database-test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "format": "prettier --write src tests e2e scripts",
    "desktop:icons": "node desktop/scripts/icons.cjs",
    "desktop:stage": "node desktop/scripts/stage-web.cjs",
    "desktop:build": "npm run desktop:icons && npm run desktop:stage && npm --prefix desktop run pack",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "node desktop/scripts/smoke.cjs",
    "desktop:test-update": "npm --prefix desktop run test:update"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@mozilla/readability": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@yowasp/clang": "22.0.0-git20542-10",
    "diff": "latest",
    "dompurify": "3.4.15",
    "fast-xml-parser": "latest",
    "fflate": "latest",
    "idb": "latest",
    "immer": "^11.1.18",
    "ipaddr.js": "latest",
    "jsdom": "26.1.0",
    "katex": "latest",
    "lucide-react": "latest",
    "mermaid": "latest",
    "next": "latest",
    "pdfjs-dist": "latest",
    "pyodide": "314.0.6",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-katex": "latest",
    "rehype-sanitize": "latest",
    "remark-gfm": "latest",
    "remark-math": "latest",
    "remark-parse": "latest",
    "sql.js": "1.14.2",
    "typescript-runtime": "npm:typescript@6.0.3",
    "undici": "latest",
    "unified": "latest",
    "unist-util-visit": "latest",
    "yaml": "^2.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@types/jsdom": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  }
}
