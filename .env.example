NEXT_PUBLIC_APP_NAME=Studyspace
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server only; optional. No AI calls are made without an explicit user action.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Free AI: guests and signed-in users receive the same generous daily allowance.
AI_FREE_DAILY_REQUEST_LIMIT=100
AI_FREE_DAILY_TOKEN_BUDGET=2000000
AI_NETWORK_DAILY_REQUEST_LIMIT=1000
AI_NETWORK_DAILY_TOKEN_BUDGET=10000000
AI_GLOBAL_DAILY_REQUEST_LIMIT=2000
AI_GLOBAL_DAILY_TOKEN_BUDGET=20000000
# Optional separate HMAC secret; defaults to the server-only Supabase service key.
AI_QUOTA_SECRET=
# Non-Vercel production only: header overwritten by your trusted reverse proxy.
AI_TRUSTED_IP_HEADER=
# Production always uses Postgres. Set database to test hosted quotas during local dev.
AI_QUOTA_BACKEND=
CROSSREF_CONTACT_EMAIL=
WORKER_POLL_MS=3000
WORKER_ID=local-worker
# Exact isolated project URL required before running destructive integration fixtures.
TEST_SUPABASE_URL=
TEST_ALLOW_MUTATIONS=no
SEED_OWNER_ID=
SEED_CONFIRM_PROJECT=
RESTORE_CONFIRM_PROJECT=

# Idle worker maintenance; referenced files are protected by transactional lifecycle locks.
STORAGE_CLEANUP_ENABLED=true
ORPHAN_GRACE_HOURS=72
EXPORT_RETENTION_DAYS=7

# Optional: automatic YouTube transcript imports (server-side only).
# Get a key at https://dash.supadata.ai and restart the server after setting it.
SUPADATA_API_KEY=

# Optional Google Calendar OAuth. Google Sign-In is configured in Supabase.
# Server only: never include these in a desktop build.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# Optional transactional collaboration email, also required by the worker.
RESEND_API_KEY=
EMAIL_FROM=

# Spreadsheet staged rollout. Local editing and on-device conversion default on.
NEXT_PUBLIC_SPREADSHEETS_READONLY=false
NEXT_PUBLIC_SPREADSHEET_CONVERSION_ENABLED=true
# Apply 20260922010000_shared_spreadsheets.sql and pass shared acceptance first.
SHARED_SPREADSHEETS_ENABLED=false
